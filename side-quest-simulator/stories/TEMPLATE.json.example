{
  "version": 1,
  "objectives": [
    {
      "id": "haunted-invoice",
      "title": "Audit a Haunted Invoice",
      "task": "persuade a haunted invoice that being overdue is not a personality",
      "art": "lich-eviction",
      "climax": {
        "id": "x-haunted-invoice",
        "text": "The invoice demands your signature in blood. Accounts Payable asks whether blue ink will do.",
        "choices": [
          {"label":"Reconcile the accounts","stat":"INT","risk":"bold","win":"The balance is zero. The invoice ascends as a credit note.","lose":"The invoice adds a charge for your time."},
          {"label":"Negotiate a living-wage payment plan","stat":"CHA","risk":"safe","win":"The invoice accepts instalments in mildly haunted copper.","lose":"It invoices you for the negotiation."},
          {"label":"Tear it up in front of Accounts Payable","stat":"STR","risk":"reckless","win":"A thousand tiny invoices are still technically paid in full.","lose":"Each piece becomes a separate overdue invoice."}
        ]
      }
    }
  ],
  "stories": [
    {
      "objective": "haunted-invoice",
      "entry": "invoice-interview",
      "scenes": [
        {
          "id": "invoice-interview",
          "art": "lich-eviction",
          "text": "The invoice's first demand is tea. Its second is your firstborn receipt.",
          "next": [{"scene":"invoice-archive"}],
          "choices": [
            {"label":"Listen to its original grievance","stat":"WIS","risk":"safe","win":"Someone once rounded it down. You find a note of the exact amount.","lose":"It reads you every reminder letter since the plague.","onWin":{"flag":"invoice-evidence","momentum":1,"memory":"You learned that the invoice was originally rounded down."}},
            {"label":"Pay for the original ledger","stat":"INT","risk":"bold","deal":{"gold":15},"hint":"Unlock an evidence-based finale approach.","win":"The original ledger contains a terrible secret: a halfpenny.","lose":"The ledger is unavailable.","onWin":{"flag":"invoice-evidence","memory":"You purchased the ledger that explains the haunted halfpenny."}}
          ]
        },
        {
          "id": "invoice-archive",
          "art": "library-book",
          "text": "The filing cabinet refuses access because the invoice is technically still alive.",
          "choices": [
            {"label":"Explain the difference between life and financial activity","stat":"INT","risk":"bold","win":"The cabinet considers its own career and unlocks.","lose":"It classifies your explanation as an unpaid consultation."},
            {"label":"Distract it with a perfectly alphabetised complaint","stat":"DEX","risk":"safe","win":"The cabinet purrs. The file slides free.","lose":"Your complaint is filed under Never."}
          ]
        }
      ],
      "finaleChoices": [
        {"label":"Show the original rounding error","stat":"INT","risk":"safe","requires":"invoice-evidence","win":"One halfpenny settles a haunting. The invoice apologises for the blood clause.","lose":"The halfpenny has accrued supernatural interest.","onWin":{"memory":"A haunted invoice found peace after you corrected a halfpenny rounding error."}}
      ]
    }
  ]
}
